# -----------------------------------------------------------------------------
# HireHub - environment template
# Reference template for environment variables. Spring Boot does not load .env files
# automatically; export these variables in your shell or IDE run configuration.
# -----------------------------------------------------------------------------

# --- Application ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
LOG_LEVEL_APP=DEBUG

# --- PostgreSQL (used from Phase 2 onwards) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hirehub
DB_USERNAME=hirehub
DB_PASSWORD=hirehub
DB_POOL_MAX=10
DB_POOL_MIN_IDLE=2

# Set both to true/DEBUG only while debugging locally. Bound parameters can contain
# personal data and must never be logged in production.
JPA_SHOW_SQL=false
LOG_LEVEL_SQL=WARN

# --- JWT (used from Phase 4 onwards) ---
# Must be a Base64-encoded secret of at least 256 bits for HS256.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=replace_with_a_generated_base64_secret
JWT_EXPIRATION_MS=3600000
JWT_ISSUER=hirehub

# --- CORS (Phase 17) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
